<UserControl x:Class="WpfClient.Views.RenderEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock
        AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.TitleText}"
        Text="Processing"
        FontSize="16"
        FontWeight="SemiBold" />

        <StackPanel
        Margin="0,16,0,0"
        AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.ProcessingPanel}">

            <StackPanel
            Orientation="Horizontal"
            Margin="0,0,0,16"
            AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.ProcessingCommandPanel}">

                <Button
                MinWidth="130"
                Margin="0,0,8,0"
                Content="{Binding LoadButtonText, ElementName=Root, FallbackValue=Load}"
                Command="{Binding LoadCommand}"
                AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.LoadButton}" />

                <Button
                MinWidth="90"
                Margin="0,0,8,0"
                Content="Process"
                Command="{Binding ProcessCommand}"
                AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.ProcessButton}" />

                <Button
                MinWidth="80"
                Content="Cancel"
                Command="{Binding CancelCommand}"
                AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.CancelButton}" />
            </StackPanel>

            <TextBlock
            Text="{Binding StatusText}"
            TextWrapping="Wrap"
            AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.StatusText}" />

            <Grid
            Margin="0,16,0,0"
            AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.ProgressPanel}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>

                <ProgressBar
                Height="18"
                Minimum="0"
                Maximum="100"
                Value="{Binding Progress}"
                AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.ProgressBar}" />

                <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ProgressText}"
                AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.ProgressText}" />
            </Grid>
        </StackPanel>

        <TextBlock
        Margin="0,16,0,0"
        Text="{Binding RawEngineEventCount, StringFormat=Native events: {0}}"
        AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.RawEngineEventCountText}" />

        <TextBlock
        Margin="0,4,0,0"
        Text="{Binding DisplayedEngineEventCount, StringFormat=UI event updates: {0}}"
        AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.DisplayedEngineEventCountText}" />

        <TextBlock
        Margin="0,4,0,0"
        Text="{Binding LastDisplayedEngineEventText}"
        AutomationProperties.AutomationId="{Binding AutomationIdPrefix, ElementName=Root, StringFormat={}{0}.LastDisplayedEngineEventText}" />
    </StackPanel>
</UserControl>
