<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:WpfClient.Views"
                    xmlns:local="clr-namespace:WpfClient"
                     xmlns:vm="clr-namespace:Presentation.ViewModels;assembly=Presentation">

    <DataTemplate DataType="{x:Type vm:HeaderViewModel}">
        <views:HeaderView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FooterViewModel}">
        <views:FooterView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ScreensViewModel}">
        <views:ScreensView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GeneralViewModel}">
        <views:GeneralView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:RenderEngineViewModel}">
        <views:RenderEngineView/>
    </DataTemplate>

</ResourceDictionary>