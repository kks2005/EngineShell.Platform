<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Clients.Maui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Clients.Maui.Controls"
    xmlns:views="clr-namespace:Clients.Maui.Views"
    xmlns:viewModels="clr-namespace:Presentation.ViewModels;assembly=Presentation"
    x:DataType="viewModels:ShellViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <views:HeaderView BindingContext="{Binding Header}" />

        <ScrollView Grid.Row="1">
            <controls:ViewModelViewHost
                Margin="24"
                ViewModel="{Binding CurrentViewModel}" />
        </ScrollView>

        <views:FooterView
            Grid.Row="2"
            BindingContext="{Binding Footer}" />
    </Grid>
</ContentPage>
