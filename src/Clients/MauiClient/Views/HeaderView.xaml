<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Clients.Maui.Views.HeaderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:EngineShell.Application.Models;assembly=EngineShell.Application"
    xmlns:viewModels="clr-namespace:Presentation.ViewModels;assembly=Presentation"
    x:DataType="viewModels:HeaderViewModel">
    <CollectionView
        AutomationId="Header.Navigation"
        BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#212121}"
        ItemsSource="{Binding NavigationItems}"
        SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
        SelectionMode="Single">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="4" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:NavigationItem">
                <HorizontalStackLayout Padding="16,12" Spacing="8">
                    <Label Text="{Binding Icon}" VerticalOptions="Center" />
                    <Label Text="{Binding Title}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
