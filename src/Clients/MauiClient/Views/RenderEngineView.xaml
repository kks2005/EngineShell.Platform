<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Clients.Maui.Views.RenderEngineView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Presentation.ViewModels;assembly=Presentation"
    x:DataType="viewModels:RenderEngineViewModel">
    <VerticalStackLayout Spacing="16">
        <Label AutomationId="RenderEngine.TitleText" Text="Processing" Style="{StaticResource Headline}" />
        <HorizontalStackLayout Spacing="8">
            <Button AutomationId="RenderEngine.LoadButton" Command="{Binding LoadCommand}" Text="Load" />
            <Button AutomationId="RenderEngine.ProcessButton" Command="{Binding ProcessCommand}" Text="Process" />
            <Button AutomationId="RenderEngine.CancelButton" Command="{Binding CancelCommand}" Text="Cancel" />
        </HorizontalStackLayout>
        <Label AutomationId="RenderEngine.InputPathText" Text="{Binding InputPath}" />
        <Label AutomationId="RenderEngine.StatusText" Text="{Binding Status}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ProgressBar
                AutomationId="RenderEngine.ProgressBar"
                Progress="{Binding Progress, Converter={StaticResource PercentToProgressConverter}}"
                VerticalOptions="Center" />
            <Label
                Grid.Column="1"
                AutomationId="RenderEngine.ProgressText"
                FontAttributes="Bold"
                Text="{Binding ProgressText}" />
        </Grid>
    </VerticalStackLayout>
</ContentView>
