<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Clients.Maui.Views.ScreensView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Presentation.ViewModels;assembly=Presentation"
    x:DataType="viewModels:ScreensViewModel">
    <VerticalStackLayout Spacing="12">
        <Label AutomationId="Screens.TitleText" Text="Screens" Style="{StaticResource Headline}" />
        <Button
            AutomationId="Screens.LoadButton"
            Command="{Binding LoadScreensCommand}"
            HorizontalOptions="Start"
            Text="Load Screens" />
        <Label Text="Run the shared screen-loading workflow using the simulator engine." />
    </VerticalStackLayout>
</ContentView>
