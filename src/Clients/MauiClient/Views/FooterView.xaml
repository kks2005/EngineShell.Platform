<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Clients.Maui.Views.FooterView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Presentation.ViewModels;assembly=Presentation"
    x:DataType="viewModels:FooterViewModel"
    Padding="16,8"
    BackgroundColor="{AppThemeBinding Light=#E1E1E1, Dark=#212121}">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <Label Text="{Binding Status, TargetNullValue=Ready}" VerticalOptions="Center" />
        <Picker
            x:Name="ThemePicker"
            Grid.Column="1"
            AutomationId="Footer.ThemePicker"
            SelectedIndex="0"
            SelectedIndexChanged="OnThemeChanged"
            Title="Theme">
            <Picker.Items>
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
            </Picker.Items>
        </Picker>
    </Grid>
</ContentView>
