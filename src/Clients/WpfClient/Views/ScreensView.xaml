<UserControl x:Class="WpfClient.Views.ScreensView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Content="Load Screens"
                    Command="{Binding LoadScreensCommand}"
                    AutomationProperties.AutomationId="Screens.LoadButton"
                    Margin="0,0,8,0"/>

            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="Screens.RefreshButton"
                    Margin="0,0,8,0"/>

            <TextBlock Text="{Binding IsBusy, StringFormat=Busy: {0}}"
                       AutomationProperties.AutomationId="Screens.BusyText"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Screens List -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Screens}"
                 SelectedItem="{Binding SelectedScreen}"
                 AutomationProperties.AutomationId="Screens.List">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Resolution}" Margin="12,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
