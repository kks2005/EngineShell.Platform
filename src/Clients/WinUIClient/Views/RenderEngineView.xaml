<UserControl
    x:Class="WinUIClient.Views.RenderEngineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16">
        <TextBlock
            Text="Processing"
            Style="{StaticResource TitleTextBlockStyle}"
            AutomationProperties.AutomationId="RenderEngine.TitleText" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                MinWidth="110"
                Content="Load"
                Command="{Binding LoadCommand}"
                AutomationProperties.AutomationId="RenderEngine.LoadButton" />
            <Button
                MinWidth="110"
                Content="Process"
                Command="{Binding ProcessCommand}"
                AutomationProperties.AutomationId="RenderEngine.ProcessButton" />
            <Button
                MinWidth="110"
                Content="Cancel"
                Command="{Binding CancelCommand}"
                AutomationProperties.AutomationId="RenderEngine.CancelButton" />
        </StackPanel>

        <TextBlock
            Text="{Binding InputPath}"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            AutomationProperties.AutomationId="RenderEngine.InputPathText" />

        <TextBlock
            Text="{Binding Status}"
            TextWrapping="Wrap"
            AutomationProperties.AutomationId="RenderEngine.StatusText" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Minimum="0"
                Maximum="100"
                Value="{Binding Progress}"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="RenderEngine.ProgressBar" />
            <TextBlock
                Grid.Column="1"
                Text="{Binding ProgressText}"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                AutomationProperties.AutomationId="RenderEngine.ProgressText" />
        </Grid>
    </StackPanel>
</UserControl>
