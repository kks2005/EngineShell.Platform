<Window
    x:Class="WinUIClient.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WinUIClient.Views"
    mc:Ignorable="d"
    Title="ClientAgnostic">
    <Grid
        x:Name="Root"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        AutomationProperties.AutomationId="Shell.MainWindow">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <views:HeaderView HorizontalAlignment="Left"
            Grid.Row="0"
            DataContext="{Binding Header}"
            AutomationProperties.AutomationId="Shell.HeaderContent" />

        <ContentControl
            Grid.Row="1"
            Padding="20"
            Content="{Binding CurrentViewModel}"
            ContentTemplateSelector="{StaticResource ViewModelTemplateSelector}"
            AutomationProperties.AutomationId="Shell.MainContent" />

        <views:FooterView
            Grid.Row="2"
            DataContext="{Binding Footer}"
            AutomationProperties.AutomationId="Shell.FooterContent" />
    </Grid>
</Window>
